    <x:String x:Key="Text_ExchangeDeviceKeyWindow_Description_Displaying">ターゲットデバイス上で以下の認証コードを入力してください</x:String>
    <sys:String x:Key="Text_ExchangeDeviceKeyWindow_YourInput">入力内容：</sys:String>
    <sys:String x:Key="Text_Greeting_Morning_1">おはよう! ο(=•ω＜=)ρ⌒☆</sys:String>
    <sys:String x:Key="Text_Greeting_Morning_2">毎日良い気分を OvO</sys:String>
    <sys:String x:Key="Text_Greeting_Morning_3">今日のイベント、今日の終わり!</sys:String>
    <sys:String x:Key="Text_Greeting_Morning_4">良い一日が始まります~</sys:String>
    <sys:String x:Key="Text_Greeting_Morning_5">朝は一日の始まり</sys:String>
    <sys:String x:Key="Text_Greeting_Noon_1">こんにちは! o(〃＾▽＾〃)o</sys:String>
    <sys:String x:Key="Text_Greeting_Noon_2">正午です、休憩してください~</sys:String>
    <sys:String x:Key="Text_Greeting_Noon_3">今日もおはようございます</sys:String>
    <sys:String x:Key="Text_Greeting_AfterNoon_1">こんにちは! ヾ(≧▽≦*)o</sys:String>
    <sys:String x:Key="Text_Greeting_AfterNoon_2">アフタヌーンティータイム!</sys:String>
    <sys:String x:Key="Text_Greeting_AfterNoon_3">今日、どのようなタスクが未完了のままになっていますか？</sys:String>
    <sys:String x:Key="Text_Greeting_Evening_1">こんばんは! o(*￣▽￣*)ブ</sys:String>
    <sys:String x:Key="Text_Greeting_Evening_2">今夜は美味しい食事をします!</sys:String>
    <sys:String x:Key="Text_Greeting_Night_1">夜は静かです! o(*￣▽￣*)ブ</sys:String>
    <sys:String x:Key="Text_Greeting_Night_2">夜遅く、早く休む</sys:String>
    <sys:String x:Key="Text_Greeting_Night_3">明日はいい日になる!</sys:String>
    <sys:String x:Key="Text_Greeting_Night_4">まだ夜更かし</sys:String>
</ResourceDictionary>
