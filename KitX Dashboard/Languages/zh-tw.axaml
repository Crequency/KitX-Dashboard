    <sys:String x:Key="Text_Bench_Diag_card_taller_than_a_screen">卡片高 {height}px，超過一屏的 {screen}px：到第 {row} 列共 {slots} 個槽。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unreadable">無法讀取 `{file}`：{reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_invalid_json">`{file}` 不是合法的 JSON：{reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_root_not_object">`{file}` 必須是一個 JSON 物件。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_missing_version">`{file}` 沒有宣告 `{field}`。一個不說自己依哪套模型寫成的檔案，不能當成目前模型來讀。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unsupported_schema">`{file}` 宣告的 `schemaVersion` 是 {version}，而本版本只認得 {expected}。寧可拒絕，也不猜測。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unsupported_layout_version">`{file}` 宣告的 `layoutVersion` 是 {version}，而本版本依 {expected} 排版。寧可拒絕，也不重排。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_elements_missing">`{file}` 裡沒有 `elements` 陣列。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unknown_field">`{file}` 有一個不認得的頂層欄位 `{field}`，已忽略。依舊版排版模型寫成的檔案常帶這種欄位。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unsupported_type">捨棄了一個元素：{reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_empty">捨棄了一個元素：它反序列化為 null。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_events_not_allowed">{kindName}（`{kind}`）不能宣告 `events`；只有 `Button` 和 `Input` 自己能發聲，其餘元素的值隨著它們一起送出。該欄位已忽略。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unknown_field">{kindName}（`{kind}`）有不認得的欄位 `{field}`，已忽略並套用預設值。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_no_key">已捨棄第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：它沒有綁定任何鍵，也沒給出鍵名。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unknown_key">已捨棄第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：這個工具包沒有宣告名為 `{key}` 的鍵。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_key_ignored">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：它顯示的是使用者輸入的值，不是已儲存的值，所以鍵 `{key}` 會被忽略——請用 `name` 說明它上傳時的名稱。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_inert">已捨棄第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：它既沒有 `name` 也沒有 `events`，既不提供值也不發聲。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_empty_label">已捨棄第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：它沒有文字，按了也沒有東西可看。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_no_events">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：它沒有宣告 `events`，按了什麼也不會送出。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_card_values_have_no_way_out">`{name}` 和旁邊這些值沒有任何東西能把它們送出去：只有 `Button`，或帶 `events` 的 `Input` 才能觸發事件。它們會留在卡片上。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_unknown_emphasis">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：`emphasis` 是 `{value}`，不在 {known} 之中；以 `normal` 繪製。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_repeated_primary">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：有 {count} 個按鈕都宣告了 `primary`；一張卡片最好只有一個主要動作。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_select_no_options">已捨棄第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：它既沒有 `options` 也沒有 `optionsKey`，沒有可選項目。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_select_ambiguous_options">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：它同時有 `options` 和 `optionsKey`；以靜態清單為準。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_list_key_not_array">已捨棄第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：鍵 `{key}` 宣告的是 `{type}`，不是 `array`。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_position_out_of_grid">已捨棄第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：`row` 是 {row}，列號必須從 1 開始。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_weight_repaired">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：`weight` 是 {weight}，以 1 處理。權重是正數的份數，一列依列內各份數之和分配寬度。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_text_unknown_format">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：`format` 是 `{value}`，本版本不認得，以純文字顯示。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_range_reversed">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：`min`（{min}）大於 `max`（{max}），範圍已捨棄。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_step_not_positive">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：`step`（{step}）不是正數，預設以 1 處理。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_decimals_negative">已保留第 {row} 列、權重 {weight} 的 {kindName}（`{kind}`）：`decimals`（{decimals}）是負數，預設交給繪製器決定。</sys:String>
    <sys:String x:Key="Text_Bench_Diag_save_failed">卡片寫不進 `{file}`：{reason}</sys:String>
