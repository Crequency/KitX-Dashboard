    <sys:String x:Key="Text_Bench_Diag_card_taller_than_a_screen">La carte mesure {height}px de haut, au-delà des {screen}px d'un écran : {slots} emplacement(s) jusqu'à la rangée {row}.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unreadable">Impossible de lire `{file}` : {reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_invalid_json">`{file}` n'est pas un JSON valide : {reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_root_not_object">`{file}` doit contenir un objet JSON.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_missing_version">`{file}` ne déclare pas `{field}`. Un fichier qui ne dit pas selon quel modèle il est écrit ne peut pas être lu comme s'il déclarait le modèle actuel.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unsupported_schema">`{file}` déclare `schemaVersion` {version} ; cette version ne comprend que {expected}. Refus plutôt que deviner.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unsupported_layout_version">`{file}` déclare `layoutVersion` {version} ; cette version dispose selon {expected}. Refus plutôt que reflow.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_elements_missing">`{file}` n'a pas de tableau `elements`.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unknown_field">`{file}` a un champ de premier niveau non reconnu `{field}` ; il a été ignoré. Les fichiers de disposition écrits pour un ancien modèle en portent souvent un.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unsupported_type">`{type}` de la ligne {row} a été écarté : {reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_empty">L'élément n° {index} de `elements` a été écarté : il s'est désérialisé en null.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_events_not_allowed">{kindName} (`{kind}`) ne peut pas déclarer `events` ; seuls `Button` et `Input` s'expriment d'eux-mêmes, et les valeurs des autres voyagent sous l'élément qui le fait. Le champ a été ignoré.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unknown_field">{kindName} (`{kind}`) a un champ non reconnu `{field}` ; il a été ignoré et la valeur par défaut appliquée.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_no_key">{kindName} (`{kind}`) écarté à la rangée {row}, poids {weight} : il n'est lié à aucune clé et aucun nom de clé n'a été fourni.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unknown_key">{kindName} (`{kind}`) écarté à la rangée {row}, poids {weight} : le ToolKit ne déclare aucune clé nommée `{key}`.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_key_ignored">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : il montre ce que la personne a saisi, pas une valeur enregistrée ; la clé `{key}` est ignorée — utilisez `name` pour dire sous quel nom il envoie.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_inert">{kindName} (`{kind}`) écarté à la rangée {row}, poids {weight} : il n'a ni `name` ni `events`, il n'apporte donc aucune valeur et n'en envoie aucune.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_empty_label">{kindName} (`{kind}`) écarté à la rangée {row}, poids {weight} : il n'a pas de libellé, il n'y a donc rien à cliquer.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_no_events">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : il ne déclare pas `events`, le clic n'envoie donc rien.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_card_values_have_no_way_out">`{name}` et les valeurs à côté n'ont rien pour les envoyer : seuls un `Button`, ou un `Input` avec `events`, déclenchent un événement. Elles restent sur la carte.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_unknown_emphasis">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : `emphasis` vaut `{value}`, qui n'est pas parmi {known} ; il est dessiné comme `normal`.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_repeated_primary">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : {count} boutons revendiquent `primary` ; une carte se lit mieux avec une seule action principale.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_select_no_options">{kindName} (`{kind}`) écarté à la rangée {row}, poids {weight} : il n'a ni `options` ni `optionsKey`, il n'y a donc rien à choisir.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_select_ambiguous_options">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : il a à la fois `options` et `optionsKey` ; la liste statique l'emporte.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_list_key_not_array">{kindName} (`{kind}`) écarté à la rangée {row}, poids {weight} : la clé `{key}` est déclarée comme `{type}`, pas `array`.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_position_out_of_grid">{kindName} (`{kind}`) écarté à la rangée {row}, poids {weight} : `row` vaut {row}, les numéros de rangée commencent à 1.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_weight_repaired">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : `weight` vaut {weight} ; il est traité comme 1. Un poids est un nombre positif de parts, et une rangée divise sa largeur par la somme des parts qu'elle contient.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_text_unknown_format">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : `format` vaut `{value}`, cette version ne le connaît pas ; il est affiché comme texte brut.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_text_unknown_role">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : `role` vaut `{value}`, cette version ne le connaît pas ; il est affiché comme corps de texte.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_range_reversed">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : `min` ({min}) dépasse `max` ({max}) ; l'intervalle est écarté.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_step_not_positive">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : `step` ({step}) n'est pas positif ; il vaut 1 par défaut.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_decimals_negative">{kindName} (`{kind}`) conservé à la rangée {row}, poids {weight} : `decimals` ({decimals}) est négatif ; c'est au moteur de rendu de choisir par défaut.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_save_failed">La carte n'a pas pu être écrite dans `{file}` : {reason}</sys:String>
