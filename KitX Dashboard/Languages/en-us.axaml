    <sys:String x:Key="Text_Bench_Diag_card_taller_than_a_screen">The card is {height}px tall, past the {screen}px of one screen: {slots} row slot(s) up to row {row}.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unreadable">Could not read `{file}`: {reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_invalid_json">`{file}` is not valid JSON: {reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_root_not_object">`{file}` must contain a JSON object.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_missing_version">`{file}` does not declare `{field}`. A file that does not say which model it is written in cannot be read as if it said the current one.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unsupported_schema">`{file}` declares `schemaVersion` {version}; this build understands {expected}. Refusing rather than guessing.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unsupported_layout_version">`{file}` declares `layoutVersion` {version}; this build lays out {expected}. Refusing rather than reflowing.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_elements_missing">`{file}` has no `elements` array.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_file_unknown_field">`{file}` has an unrecognised top-level field `{field}`; it was ignored. Layout files written for an older layout model often carry one.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unsupported_type">Dropped one element: {reason}</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_empty">Dropped one element: it deserialised to null.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_events_not_allowed">{kindName} cannot declare `events`; only a `Button` or an `Input` speaks on its own, and the others' values travel under whichever element does. The field was ignored.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unknown_field">{kindName} has an unrecognised field `{field}`; it was ignored and the default applied.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_no_key">Dropped {kindName} at row {row}, weight {weight}: it is not bound to a key and no key name was given.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_unknown_key">Dropped {kindName} at row {row}, weight {weight}: the ToolKit does not declare a key named `{key}`.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_key_ignored">Kept {kindName} at row {row}, weight {weight}: it shows what the person typed, not a stored value; key `{key}` is ignored — use `name` to say what it uploads as.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_inert">Dropped {kindName} at row {row}, weight {weight}: it has no `name` and no `events`, so it neither contributes a value nor sends one.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_empty_label">Dropped {kindName} at row {row}, weight {weight}: it has no label, so there is nothing to click.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_no_events">Kept {kindName} at row {row}, weight {weight}: it declares no `events`, so clicking it sends nothing.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_card_values_have_no_way_out">`{name}` and the values beside it have nothing that sends them: only a `Button`, or an `Input` with `events`, raises an event. They stay on the card.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_unknown_emphasis">Kept {kindName} at row {row}, weight {weight}: `emphasis` is `{value}`, which is not one of {known}; it is drawn as `normal`.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_button_repeated_primary">Kept {kindName} at row {row}, weight {weight}: {count} buttons claim `primary`; a card reads best with at most one main action.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_select_no_options">Dropped {kindName} at row {row}, weight {weight}: it has neither `options` nor `optionsKey`, so there is nothing to choose from.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_select_ambiguous_options">Kept {kindName} at row {row}, weight {weight}: it has both `options` and `optionsKey`; the static list wins.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_list_key_not_array">Dropped {kindName} at row {row}, weight {weight}: key `{key}` is declared as `{type}`, not `array`.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_position_out_of_grid">Dropped {kindName} at row {row}, weight {weight}: `row` is {row}, row numbers start at 1.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_weight_repaired">Kept {kindName} at row {row}, weight {weight}: `weight` is {weight}; it is treated as 1. A weight is a positive number of parts, and a row divides its width by the sum of the parts in it.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_text_unknown_format">Kept {kindName} at row {row}, weight {weight}: `format` is `{value}`, which this build does not know; it is shown as plain text.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_range_reversed">Kept {kindName} at row {row}, weight {weight}: `min` ({min}) is greater than `max` ({max}); the range is dropped.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_step_not_positive">Kept {kindName} at row {row}, weight {weight}: `step` ({step}) is not positive; it defaults to 1.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_element_number_decimals_negative">Kept {kindName} at row {row}, weight {weight}: `decimals` ({decimals}) is negative; it defaults to the renderer's choice.</sys:String>
    <sys:String x:Key="Text_Bench_Diag_save_failed">The card could not be written to `{file}`: {reason}</sys:String>
