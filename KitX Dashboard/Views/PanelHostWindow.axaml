<Window x:Class="KitX.Dashboard.Views.PanelHostWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:icon="using:Material.Icons.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="using:KitX.Dashboard.ViewModels"
        xmlns:views="using:KitX.Dashboard.Views"
        xmlns:converters="using:KitX.Dashboard.Converters"
        Title="{DynamicResource Text_PanelHost_Title}"
        Width="1000"
        Height="680"
        d:DesignHeight="680"
        d:DesignWidth="1000"
        Icon="avares://KitX.Dashboard.Assets/KitX-Icon-32x32.png"
        TransparencyLevelHint="Mica"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">
    <Window.Resources>
        <converters:InstanceStatusToBrushConverter x:Key="InstanceStatusToBrushConverter"/>
        <!-- ── Panel control render templates (fixed ten-control set, card-styled) ── -->
        <DataTemplate x:Key="PanelTextTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
        </DataTemplate>

        <DataTemplate x:Key="PanelIconTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <icon:MaterialIcon Width="24" Height="24" Kind="InformationOutline"/>
        </DataTemplate>

        <DataTemplate x:Key="PanelButtonTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <Button Command="{Binding ClickCommand}" Content="{Binding Text}" IsEnabled="{Binding IsEnabled}"
                    HorizontalAlignment="Stretch"/>
        </DataTemplate>

        <DataTemplate x:Key="PanelInputTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Value, Mode=TwoWay}" Watermark="{Binding StaticText}"
                         MinWidth="200" IsEnabled="{Binding IsEnabled}"/>
                <Button Command="{Binding SubmitCommand}" Content="{DynamicResource Text_Panel_Submit}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PanelNumberTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <NumericUpDown Value="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                           ValueChanged="OnNumberValueChanged"/>
        </DataTemplate>

        <DataTemplate x:Key="PanelSelectTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <ComboBox ItemsSource="{Binding SelectItems}" SelectedItem="{Binding Value, Mode=TwoWay}"
                      IsEnabled="{Binding IsEnabled}" SelectionChanged="OnSelectSelectionChanged"/>
        </DataTemplate>

        <DataTemplate x:Key="PanelSwitchTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <ToggleSwitch IsChecked="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                          Command="{Binding ToggleCommand}" CommandParameter="{Binding Value}"/>
        </DataTemplate>

        <DataTemplate x:Key="PanelLogTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <Border Padding="8" CornerRadius="4" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" FontFamily="Consolas, monospace" Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PanelProgressTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <StackPanel Spacing="4">
                <ProgressBar Value="{Binding Value}" Minimum="0" Maximum="100" Height="8"/>
                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding Value, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PanelDialogTemplate" DataType="{x:Type viewModels:PanelControlViewModel}">
            <Border Padding="12" CornerRadius="6"
                    BorderBrush="{DynamicResource ThemePrimaryAccent}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                    <Button Command="{Binding DialogConfirmCommand}" CommandParameter="确定"
                            Content="{DynamicResource Text_Panel_Confirm}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <views:PanelControlTemplateSelector x:Key="PanelControlTemplateSelector"
                                            TextTemplate="{StaticResource PanelTextTemplate}"
                                            IconTemplate="{StaticResource PanelIconTemplate}"
                                            ButtonTemplate="{StaticResource PanelButtonTemplate}"
                                            InputTemplate="{StaticResource PanelInputTemplate}"
                                            NumberTemplate="{StaticResource PanelNumberTemplate}"
                                            SelectTemplate="{StaticResource PanelSelectTemplate}"
                                            SwitchTemplate="{StaticResource PanelSwitchTemplate}"
                                            LogTemplate="{StaticResource PanelLogTemplate}"
                                            ProgressTemplate="{StaticResource PanelProgressTemplate}"
                                            DialogTemplate="{StaticResource PanelDialogTemplate}"/>
    </Window.Resources>

    <Grid RowDefinitions="60, Auto, *" Margin="16">
        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <icon:MaterialIcon Width="26" Height="26" Kind="ViewList"/>
                <StackPanel Spacing="2">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Text_PanelHost_Title}"/>
                    <TextBlock FontSize="12" Opacity="0.6" Text="{Binding Summary}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding TogglePickerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="18" Height="18" Kind="Plus"/>
                        <TextBlock Text="{DynamicResource Text_PanelHost_NewInstance}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenBenchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="18" Height="18" Kind="Toolbox"/>
                        <TextBlock Text="{DynamicResource Text_PanelHost_OpenBench}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EndAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="18" Height="18" Kind="StopCircle"/>
                        <TextBlock Text="{DynamicResource Text_PanelHost_EndAll}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Trigger selector (collapsible) -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="12" CornerRadius="8"
                BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}" BorderThickness="1"
                IsVisible="{Binding IsPickerVisible}">
            <StackPanel Spacing="8">
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Text_PanelHost_NewInstance}"/>
                <Grid ColumnDefinitions="*, 12, *, 12, 2*, Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{DynamicResource Text_PanelHost_PickerToolkit}"/>
                        <ComboBox ItemsSource="{Binding MountedToolkits}"
                                  SelectedItem="{Binding SelectedToolkit}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Meta.Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{DynamicResource Text_PanelHost_PickerTrigger}"/>
                        <ComboBox ItemsSource="{Binding ManualTriggers}"
                                  SelectedItem="{Binding SelectedTrigger}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{DynamicResource Text_PanelHost_PickerPayload}"/>
                        <TextBox Text="{Binding PayloadText}" Watermark="{DynamicResource Text_PanelHost_PickerPayloadHint}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"/>
                    </StackPanel>
                    <Button Grid.Column="5" VerticalAlignment="Bottom" Margin="8,0,0,0"
                            Command="{Binding NewInstanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:MaterialIcon Width="18" Height="18" Kind="Play"/>
                            <TextBlock Text="{DynamicResource Text_PanelHost_StartInstance}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding PickerMessage}" IsVisible="{Binding HasPickerMessage}"/>
            </StackPanel>
        </Border>

        <!-- Body: grouped instance tree (left) + selected panel (right) -->
        <Grid Grid.Row="2" ColumnDefinitions="320, 12, *">
            <!-- Instance tree -->
            <Border Grid.Column="0" CornerRadius="{DynamicResource KitXRadiusCard}"
                    BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}" BorderThickness="1">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding InstanceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Name}" IsExpanded="True">
                                    <ListBox ItemsSource="{Binding Instances}"
                                             SelectedItem="{Binding $parent[Window].DataContext.SelectedInstance}"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontSize="12" Text="{Binding InstanceId}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Status}"
                                                               Foreground="{Binding Status, Converter={StaticResource InstanceStatusToBrushConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

            <!-- Selected detail / panel area -->
            <Border Grid.Column="2" CornerRadius="{DynamicResource KitXRadiusCard}"
                    BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}" BorderThickness="1">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding IsEmpty}">
                        <icon:MaterialIcon Width="40" Height="40" HorizontalAlignment="Center" Kind="ViewList"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Opacity="0.6"
                                   Text="{DynamicResource Text_PanelHost_NoSelection}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding NoPanel, FallbackValue=False}">
                        <icon:MaterialIcon Width="40" Height="40" HorizontalAlignment="Center" Kind="ViewList"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Opacity="0.6"
                                   Text="{DynamicResource Text_PanelHost_NoPanel}"/>
                    </StackPanel>

                    <!-- Interactive panel control projection -->
                    <ScrollViewer IsVisible="{Binding HasPanel, FallbackValue=False}">
                        <StackPanel Margin="16" Spacing="10">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Text_PanelHost_Panel}"/>
                            <ItemsControl ItemsSource="{Binding PanelControls}"
                                          ItemTemplate="{StaticResource PanelControlTemplateSelector}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
