<Window x:Class="KitX.Dashboard.Views.BenchWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KitX.Dashboard.Views.Pages.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:icon="using:Material.Icons.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nd="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
        xmlns:viewModels="using:KitX.Dashboard.ViewModels"
        Title="{DynamicResource Text_Bench_Title}"
        Width="1100"
        Height="700"
        d:DesignHeight="700"
        d:DesignWidth="1100"
        Icon="avares://KitX.Dashboard.Assets/KitX-Icon-32x32.png"
        TransparencyLevelHint="Mica"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">
    <Window.Resources>
        <DataTemplate x:Key="BenchInputTemplate" DataType="{x:Type viewModels:BenchConnectorVM}">
            <nd:NodeInput IsConnected="{Binding IsConnected}" Anchor="{Binding Anchor, Mode=OneWayToSource}">
                <nd:NodeInput.Header>
                    <TextBlock Text="{Binding Title}" FontSize="11"/>
                </nd:NodeInput.Header>
            </nd:NodeInput>
        </DataTemplate>
        <DataTemplate x:Key="BenchOutputTemplate" DataType="{x:Type viewModels:BenchConnectorVM}">
            <nd:NodeOutput IsConnected="{Binding IsConnected}" Anchor="{Binding Anchor, Mode=OneWayToSource}">
                <nd:NodeOutput.Header>
                    <TextBlock Text="{Binding Title}" FontSize="11"/>
                </nd:NodeOutput.Header>
            </nd:NodeOutput>
        </DataTemplate>
    </Window.Resources>
    <Grid RowDefinitions="60, *" Margin="16">
        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                <icon:MaterialIcon Width="26" Height="26" Kind="Toolbox"/>
                <StackPanel Spacing="2">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding ActiveToolkit.Meta.Name}"/>
                    <TextBlock FontSize="12" Opacity="0.6" Text="{Binding TriggerSummary}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                <Button Command="{Binding FireFirstManualCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="18" Height="18" Kind="Play"/>
                        <TextBlock Text="{DynamicResource Text_Bench_ManualTrigger}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Body: left config panel + center canvas -->
        <Grid Grid.Row="1" ColumnDefinitions="300, *, 4">
            <Grid Grid.Column="0" RowDefinitions="*, 12, 3*">
                <!-- Triggers -->
                <StackPanel Grid.Row="0" Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Text_Bench_Triggers}"/>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Triggers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8" CornerRadius="6"
                                            BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="2">
                                            <DockPanel>
                                                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Id}"/>
                                                <TextBlock Margin="8,0,0,0"
                                                           HorizontalAlignment="Right"
                                                           FontSize="11"
                                                           Opacity="0.6"
                                                           Text="{Binding Type}"/>
                                            </DockPanel>
                                            <TextBlock FontSize="11"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Bindings.Count, StringFormat='{}{0} 绑定'}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Workflows -->
                <GridSplitter Grid.Row="1" ResizeDirection="Rows"/>
                <StackPanel Grid.Row="2" Margin="0,8,8,0">
                    <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Text_Bench_Workflows}"/>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Workflows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8" CornerRadius="6"
                                            BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock FontSize="13" Text="{Binding Name}"/>
                                            <TextBlock Margin="8,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       Text="{Binding File}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- Center: NodifyM Bench canvas (config → node/edge projection) -->
            <Grid Grid.Column="1" Margin="8,0,8,0">
                <Border BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Empty state: no ToolKit shown -->
                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsVisible="{Binding IsEmpty}">
                            <icon:MaterialIcon Width="48"
                                               Height="48"
                                               HorizontalAlignment="Center"
                                               Kind="Network"/>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="16"
                                       Text="{DynamicResource Text_Bench_NoToolkit}"/>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Text="{DynamicResource Text_Bench_NoToolkitHint}"/>
                        </StackPanel>

                        <!-- NodifyM editor -->
                        <nd:NodifyEditor Grid.Row="0"
                                         DataContext="{Binding Canvas}"
                                         ItemsSource="{Binding Canvas.Nodes}"
                                         Connections="{Binding Canvas.Connections}"
                                         Background="Transparent">
                            <nd:NodifyEditor.ConnectionTemplate>
                                <DataTemplate>
                                    <nd:Connection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}"
                                                   StrokeThickness="2"
                                                   Direction="Forward"/>
                                </DataTemplate>
                            </nd:NodifyEditor.ConnectionTemplate>
                            <nd:NodifyEditor.ItemTemplate>
                                <nd:NodeTemplateSelector>
                                    <DataTemplate DataType="{x:Type viewModels:BenchNodeVM}">
                                        <nd:Node Location="{Binding Location}"
                                                 Input="{Binding Input}"
                                                 Output="{Binding Output}"
                                                 InputConnectorTemplate="{StaticResource BenchInputTemplate}"
                                                 OutputConnectorTemplate="{StaticResource BenchOutputTemplate}"
                                                 IsResize="False">
                                            <nd:Node.Header>
                                                <Border Padding="10,4" Background="{DynamicResource ThemePrimaryAccent}">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="White"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"/>
                                                        <TextBlock Text="{Binding KindLabel}"
                                                                   Foreground="White"
                                                                   Opacity="0.8"
                                                                   FontSize="10"/>
                                                    </StackPanel>
                                                </Border>
                                            </nd:Node.Header>
                                        </nd:Node>
                                    </DataTemplate>
                                </nd:NodeTemplateSelector>
                            </nd:NodifyEditor.ItemTemplate>
                        </nd:NodifyEditor>

                        <StackPanel Grid.Row="1"
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <TextBlock FontSize="12" Opacity="0.8"
                                       Text="{Binding ValidationIssues.Count, StringFormat='{}{0} 项配置校验'}"/>
                            <TextBlock FontSize="12" Opacity="0.6"
                                       Text="{DynamicResource Text_Bench_ConfigTruth}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="2" ResizeDirection="Columns"/>
        </Grid>
    </Grid>
</Window>
