<Window x:Class="KitX.Dashboard.Views.SurfaceEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:Material.Icons.Avalonia"
        xmlns:decl="using:KitX.ToolKit.Contract.Declaration"
        xmlns:viewModels="using:KitX.Dashboard.ViewModels"
        Title="{DynamicResource Text_Bench_Surface_Title}"
        Width="1180"
        Height="900"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!--
          The canvas is a fixed 390 x 845 rectangle, centred, with margin around it. It is not
          stretched to the window and has no zoom control: stretching would make "what you see is
          what you get" a lie (a 1600-wide window would lay out a desktop card), and zooming would
          make the author answer a question this screen cannot — how wide is one cell right now.
        -->
        <Style Selector="Border.canvas">
            <Setter Property="Width" Value="390" />
            <Setter Property="Height" Value="845" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="16">

        <!-- ── toolbar ───────────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                <TextBlock Text="{DynamicResource Text_Bench_Surface_Title}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ToolkitId}"
                           FontSize="12"
                           Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="ContentSave" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Save}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="DeleteSweep" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Clear}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── editor body ──────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="220, *, 260">

            <!-- left: the palette is "declared but not placed", not "kinds of control" -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource Text_Bench_Surface_Palette}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource Text_Bench_Surface_PaletteHint}"
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <ListBox ItemsSource="{Binding UnplacedKeys}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type decl:KeyDeclaration}">
                                <Button Classes="palette"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].DataContext.PlaceCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Vertical" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11" Opacity="0.6">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="Type" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- centre: the fixed canvas, scrolled rather than stretched when the window is short -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,0">
                <!-- Named so a test can reach it without depending on when the visual tree is
                     built: an unreached visual cannot be checked for the brushes it resolved. -->
                <Border x:Name="SurfaceCanvas" Classes="canvas">
                    <Grid RowDefinitions="Auto,*">
                        <!-- A scale for the rows below, not a grid: since Q101 a row divides itself
                             and its cells have no width in common with the next row's. Four equal
                             ticks would name divisions that nothing on the canvas uses. -->
                        <Border Grid.Row="0" Height="24"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                BorderThickness="0,0,0,1" />

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Elements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <!--
                                  A ControlTheme's setters are resolved outside this file's XAML name
                                  scope, so a cast such as ((viewModels:SurfaceElementVM)DataContext)
                                  cannot be resolved there at runtime: the window threw
                                  "Unable to resolve type viewModels:SurfaceElementVM" while measuring
                                  and never appeared. The cast was never needed — the ContentPresenter
                                  this theme targets has the element itself as its DataContext, so a
                                  plain path reaches the same property.
                                -->
                                <ControlTheme TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:SurfaceElementVM}">
                                    <Border Width="{Binding Width}"
                                            Height="{Binding Height}"
                                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8"
                                            ToolTip.Tip="{Binding Description}">
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Kind}"
                                                       FontSize="10"
                                                       Opacity="0.6" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!--  The two numbers are drafts, so they take effect when
                                                  applied and not while being typed: a width is a
                                                  share of the row, so each edit resizes its
                                                  neighbours too. Minimum only constrains the
                                                  spinner; the commands' own guard covers the rest.  -->
                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto">
                                                <NumericUpDown Grid.Column="0"
                                                               Value="{Binding DraftWeight}"
                                                               Minimum="1"
                                                               Maximum="10"
                                                               Increment="1"
                                                               FormatString="0"
                                                               Width="72"
                                                               ToolTip.Tip="{DynamicResource Text_Bench_Surface_WeightHint}" />
                                                <!--  A tick rather than the word "apply": the row is
                                                      often narrower than the canvas and a word
                                                      would be truncated to "app…" on exactly the
                                                      cells where the number matters most.  -->
                                                <Button Grid.Column="1"
                                                        Classes="flat"
                                                        Margin="4,0,0,0"
                                                        Content="✓"
                                                        ToolTip.Tip="{DynamicResource Text_Bench_Surface_ApplyWeight}"
                                                        Command="{Binding $parent[Window].DataContext.SetWeightCommand}"
                                                        CommandParameter="{Binding}" />
                                                <NumericUpDown Grid.Column="2"
                                                               Value="{Binding DraftRow}"
                                                               Minimum="1"
                                                               Maximum="99"
                                                               Increment="1"
                                                               FormatString="0"
                                                               Width="72"
                                                               HorizontalAlignment="Right"
                                                               ToolTip.Tip="{DynamicResource Text_Bench_Surface_RowHint}" />
                                                <Button Grid.Column="3"
                                                        Classes="flat"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding $parent[Window].DataContext.RemoveCommand}"
                                                        CommandParameter="{Binding Element}">
                                                    <icon:MaterialIcon Width="14" Height="14" Kind="Close" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- right: what "save and check" found, named rather than summarised -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="12,0,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Text_Bench_Surface_Check}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{DynamicResource Text_Bench_Surface_NoValuesHint}"
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />

                    <Border IsVisible="{Binding HasValidationMessage}"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="8">
                        <TextBlock Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                    </Border>

                    <TextBlock Text="{Binding Status}"
                               FontSize="12"
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── footer ───────────────────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2"
                   Text="{DynamicResource Text_Bench_Surface_Footer}"
                   FontSize="11"
                   Opacity="0.6"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
