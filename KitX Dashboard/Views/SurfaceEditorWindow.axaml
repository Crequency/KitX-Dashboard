<Window x:Class="KitX.Dashboard.Views.SurfaceEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:Material.Icons.Avalonia"
        xmlns:decl="using:KitX.ToolKit.Contract.Declaration"
        xmlns:viewModels="using:KitX.Dashboard.ViewModels"
        Title="{DynamicResource Text_Bench_Surface_Title}"
        Width="1180"
        Height="900"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!--
          The canvas is a fixed 390 x 845 rectangle, centred, with margin around it. It is not
          stretched to the window and has no zoom control: stretching would make "what you see is
          what you get" a lie (a 1600-wide window would lay out a desktop card), and zooming would
          make the author answer a question this screen cannot — how wide is one cell right now.
        -->
        <Style Selector="Border.canvas">
            <Setter Property="Width" Value="390" />
            <Setter Property="Height" Value="845" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--
          The grip is invisible until the pointer is near it. Always-drawn handles would put eleven
          lines on a card that will be seen with none, and the author would be laying out around the
          editor's furniture. Cursor is set to the resize shape so pointing at the gap says what it
          does without a caption.
        -->
        <Style Selector="Border.grip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.grip:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *" Margin="16">

        <!-- ── toolbar ───────────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                <TextBlock Text="{DynamicResource Text_Bench_Surface_Title}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ToolkitId}"
                           FontSize="12"
                           Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="ContentSave" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Save}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="DeleteSweep" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Clear}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── editor body ──────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="220, *, 260">

            <!-- left: the palette is "declared but not placed", not "kinds of control" -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource Text_Bench_Surface_Palette}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <ListBox ItemsSource="{Binding UnplacedKeys}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type decl:KeyDeclaration}">
                                <Button Classes="palette"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].DataContext.PlaceCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Vertical" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11" Opacity="0.6">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="Type" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- centre: the fixed canvas, scrolled rather than stretched when the window is short -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,0">
                <!-- Named so a test can reach it without depending on when the visual tree is
                     built: an unreached visual cannot be checked for the brushes it resolved. -->
                <Border x:Name="SurfaceCanvas" Classes="canvas">
                    <Grid RowDefinitions="Auto,*">
                        <!-- A scale for the rows below, not a grid: since Q101 a row divides itself
                             and its cells have no width in common with the next row's. Four equal
                             ticks would name divisions that nothing on the canvas uses. -->
                        <Border Grid.Row="0" Height="24"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                BorderThickness="0,0,0,1" />

                        <!--
                          Both layers share this cell. A Canvas arranges children at absolute
                          positions but gives them no size of their own, so an ItemsControl placed
                          directly inside one measures to zero and draws nothing — the cells were
                          laid out correctly and never rendered. They live in a Grid instead, and
                          the Grid is what the drag measures its x against.
                        -->
                        <Grid Grid.Row="1" x:Name="SurfaceCanvasLayer">

                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <!--
                                      A ControlTheme's setters are resolved outside this file's XAML
                                      name scope, so a cast such as
                                      ((viewModels:SurfaceElementVM)DataContext) cannot be resolved
                                      there at runtime: the window threw "Unable to resolve type
                                      viewModels:SurfaceElementVM" while measuring and never
                                      appeared. The cast was never needed — the ContentPresenter
                                      this theme targets has the element itself as its DataContext,
                                      so a plain path reaches the same property.
                                    -->
                                    <ControlTheme TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SurfaceElementVM}">
                                        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                ToolTip.Tip="{Binding Description}">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <!--  Trimming, not clipping: at ten equal weights a
                                                      cell is 31px wide and 15px of that is content,
                                                      so "Button" cannot be drawn. Left to clip it
                                                      renders as "But", which reads as a word rather
                                                      than as a cut.  -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Kind}"
                                                           FontSize="10"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!--  One control, at the bottom right: remove. A
                                                      weight is not typed here any more — dragging the
                                                      border beside the cell sets it, so there is
                                                      nothing to confirm and nothing to explain.  -->
                                                <Button Grid.Row="2"
                                                        Classes="flat"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        ToolTip.Tip="{DynamicResource Text_Bench_Surface_Remove}"
                                                        Command="{Binding $parent[Window].DataContext.RemoveCommand}"
                                                        CommandParameter="{Binding}">
                                                    <icon:MaterialIcon Width="14" Height="14" Kind="Close" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                              Borders last, so they draw above the cells and take the press in the
                              gap rather than letting it fall through to a cell's content.
                            -->
                            <ItemsControl ItemsSource="{Binding Boundaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SurfaceBoundaryVM}">
                                        <!--
                                          The grab area is exactly one gap wide, so it never covers
                                          a cell's own content. Pointer capture is taken on press
                                          and released on lift: the drag is the whole interaction,
                                          and there is no state left behind after it.
                                        -->
                                        <Border Classes="grip"
                                                Width="{Binding HitWidth}"
                                                Height="{Binding Height}"
                                                PointerPressed="OnBoundaryPressed"
                                                PointerMoved="OnBoundaryMoved"
                                                PointerReleased="OnBoundaryReleased">
                                            <Border Width="3"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                    Opacity="0.35"
                                                    IsHitTestVisible="False" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- right: what "save and check" found, named rather than summarised -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="12,0,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Text_Bench_Surface_Check}"
                               FontWeight="SemiBold" />

                    <Border IsVisible="{Binding HasValidationMessage}"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="8">
                        <TextBlock Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                    </Border>

                    <TextBlock Text="{Binding Status}"
                               FontSize="12"
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
