<Window x:Class="KitX.Dashboard.Views.SurfaceEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:Material.Icons.Avalonia"
        xmlns:contract="using:KitX.ToolKit.Contract"
        xmlns:decl="using:KitX.ToolKit.Contract.Declaration"
        xmlns:viewModels="using:KitX.Dashboard.ViewModels"
        xmlns:converters="using:KitX.Dashboard.Converters"
        Title="{DynamicResource Text_Bench_Surface_Title}"
        Width="1180"
        Height="900"
        KeyDown="OnWindowKeyDown"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--
          The check panel shows a save's findings. Each one arrives as the contract's Diagnostic:
          a code, an English sentence, and the values that sentence was built from. The converter
          composes the sentence this client shows — the code names a resource key, the values fill
          its named placeholders, and a code with no key falls back to the English sentence.
        -->
        <viewModels:SurfaceDiagnosticTextConverter x:Key="SurfaceDiagnosticText" />

        <!--
          Element kinds are drawn in the reader's language, but the collections that carry them stay
          in the schema's own words: the palette's command parameter and the type dropdown's value
          are compared against "Button"/"Input", so translating the collection would break both and
          would go stale the moment the language changed. See SurfaceKindNameConverter.
        -->
        <converters:SurfaceKindNameConverter x:Key="SurfaceKindName" />
    </Window.Resources>

    <Window.Styles>
        <!--
          The canvas is the card's own rectangle, centred, with margin around it. It is not stretched
          to the window and has no zoom control: stretching would make "what you see is what you get"
          a lie (a 1600-wide window would lay out a desktop card), and zooming would make the author
          answer a question this screen cannot — how wide is one cell right now.

          Its size is bound to the view model instead of written here, and both sides read it from
          SurfaceMetrics. The rectangle used to be two literals (390 x 845) with a third copy in the
          editor, which is how the canvas came to hold eight rows of a card that holds thirteen.
        -->
        <Style Selector="Border.canvas">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <!--
              A card has to look like one object on the window's background, or the author cannot see
              where the screen ends and the thing being laid out begins. The previous pair — the
              window's own layer fill and a 1px secondary stroke — drew a rectangle the same colour as
              the surface it sat on, which is why the canvas had no edge at all. These are the two
              brushes WinUI's own cards use, plus the shadow that makes the sheet sit above the page.
            -->
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #22000000" />
        </Style>

        <!--
          The grip is invisible until the pointer is near it. Always-drawn handles would put eleven
          lines on a card that will be seen with none, and the author would be laying out around the
          editor's furniture. Cursor is set to the resize shape so pointing at the gap says what it
          does without a caption.
        -->
        <!--
          The selected cell, drawn rather than captioned: the frame around it is the only statement on
          this canvas that says what the inspector is describing, and a second one ("editing: ...") in
          the right column would be a sentence doing a border's job.
        -->
        <Style Selector="Border.cell.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Border.grip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.grip:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
        </Style>

        <!--
          The landing line of a cell drag. Accent-coloured because it is the same statement as the
          selected cell's frame — "this is where the editor's next act happens" — and it must be the
          one thing on the canvas that is neither a cell nor a border between two of them.
        -->
        <Style Selector="Border.dropline">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *" Margin="16">

        <!-- ── toolbar ───────────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                <TextBlock Text="{DynamicResource Text_Bench_Surface_Title}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SurfaceSubtitle"
                           Text="{Binding DisplayName}"
                           FontSize="12"
                           Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="ContentSave" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Save}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="DeleteSweep" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Clear}" />
                    </StackPanel>
                </Button>
                <!--
                  Beside "Empty the card" because both are gestures about the whole document rather
                  than about the selected cell. It is not hidden away behind the blank rows it removes:
                  those rows are the ones the author just made blank, and a command whose name does not
                  mention them is a command nobody looks for.
                -->
                <Button Command="{Binding CompressRowsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="ArrowCollapseVertical" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_CompressRows}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── editor body ──────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="220, *, 260">

            <!--
              left: two lists, and the order between them is the point. What is declared comes first,
              so a card is built out of what the ToolKit publishes; the interactive kinds come second,
              under their own heading, because a card with data on it and no way to press anything
              cannot be authored at all — which is what the previous build offered.
            -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0,0,12,0">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource Text_Bench_Surface_Palette}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding UnplacedKeys}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type decl:KeyDeclaration}">
                                <Button Classes="palette"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].DataContext.PlaceCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Vertical" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Text="{DynamicResource Text_Bench_Surface_Actions}"
                               FontWeight="SemiBold"
                               Margin="0,16,0,8" />

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding PaletteKinds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="palette"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].DataContext.AddKindCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Converter={StaticResource SurfaceKindName}}"
                                               FontWeight="SemiBold" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- centre: the fixed canvas, scrolled rather than stretched when the window is short -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,0">
                <!-- Named so a test can reach it without depending on when the visual tree is
                     built: an unreached visual cannot be checked for the brushes it resolved. -->
                <Border x:Name="SurfaceCanvas"
                        Classes="canvas"
                        Width="{Binding CanvasWidth}"
                        Height="{Binding CanvasHeight}"
                        PointerPressed="OnCanvasPressed">
                    <!--
                      The cells start at the card's own top edge. There used to be a 24px scale band
                      here, which pushed every cell down by 24 pixels — the renderer draws no band, so
                      the canvas was showing a card that began 24px lower than the real one and had
                      room for one row fewer. The scale named no division that the card has anyway.
                    -->
                    <Grid>
                        <!--
                          Both layers share this cell. A Canvas arranges children at absolute
                          positions but gives them no size of their own, so an ItemsControl placed
                          directly inside one measures to zero and draws nothing — the cells were
                          laid out correctly and never rendered. They live in a Grid instead, and
                          the Grid is what the drag measures its x against.
                        -->
                        <Grid x:Name="SurfaceCanvasLayer">

                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <!--
                                      A ControlTheme's setters are resolved outside this file's XAML
                                      name scope, so a cast such as
                                      ((viewModels:SurfaceElementVM)DataContext) cannot be resolved
                                      there at runtime: the window threw "Unable to resolve type
                                      viewModels:SurfaceElementVM" while measuring and never
                                      appeared. The cast was never needed — the ContentPresenter
                                      this theme targets has the element itself as its DataContext,
                                      so a plain path reaches the same property.
                                    -->
                                    <ControlTheme TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SurfaceElementVM}">
                                        <Border Classes="cell"
                                                Classes.selected="{Binding IsSelected}"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                PointerPressed="OnCellPressed"
                                                PointerMoved="OnCellPointerMoved"
                                                PointerReleased="OnCellPointerReleased"
                                                PointerCaptureLost="OnCellCaptureLost"
                                                ToolTip.Tip="{Binding Description}">
                                            <!--
                                              Stacked from the cell's top edge, not centred: a cell is
                                              one slot (64px) or, for a List, six. Centring the label
                                              put "items" in the middle of a 384px box, and the three
                                              rows the old template stacked (kind, label, remove) need
                                              more than the 48px a one-slot cell has left inside its
                                              padding — the label was clipped in half. The remove
                                              button overlays the corner instead of taking a row.
                                            -->
                                            <Grid>
                                                <!--  Trimming, not clipping: at ten equal weights a
                                                      cell is 31px wide and 15px of that is content,
                                                      so "Button" cannot be drawn. Left to clip it
                                                      renders as "But", which reads as a word rather
                                                      than as a cut.  -->
                                                <TextBlock Text="{Binding Kind, Converter={StaticResource SurfaceKindName}}"
                                                           FontSize="10"
                                                           Opacity="0.6"
                                                           VerticalAlignment="Top"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,14,0,0"
                                                           VerticalAlignment="Top"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!--
                                                  There was a remove button here, 48x34 at the bottom
                                                  right, and it overlapped the label of every one-slot
                                                  cell by 48x18 — a click aimed at the cell's lower left
                                                  deleted the cell instead, and the auto-save wrote it
                                                  to disk with nothing said on screen. A cell may be 31
                                                  DIP wide by design (ShareableWidth), 15 of which is
                                                  content: a button with consequences cannot be made to
                                                  fit by making it smaller. Removing is now an explicit
                                                  act in the inspector, and Delete or Backspace on the
                                                  canvas does the same thing.
                                                -->
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                              Borders last, so they draw above the cells and take the press in the
                              gap rather than letting it fall through to a cell's content.
                            -->
                            <ItemsControl ItemsSource="{Binding Boundaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SurfaceBoundaryVM}">
                                        <!--
                                          The grab area is exactly one gap wide, so it never covers
                                          a cell's own content. Pointer capture is taken on press
                                          and released on lift: the drag is the whole interaction,
                                          and there is no state left behind after it.
                                        -->
                                        <Border Classes="grip"
                                                Width="{Binding HitWidth}"
                                                Height="{Binding Height}"
                                                PointerPressed="OnBoundaryPressed"
                                                PointerMoved="OnBoundaryMoved"
                                                PointerReleased="OnBoundaryReleased">
                                            <Border Width="3"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                    Opacity="0.35"
                                                    IsHitTestVisible="False" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                              The drop line, drawn above everything else so no cell can hide the place
                              it points at. It takes no presses: the drag already holds the pointer,
                              and a line that answered one would end the gesture it is describing.
                            -->
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="SurfaceDropLine"
                                        Classes="dropline"
                                        IsVisible="{Binding DropIndicator.IsVisible}"
                                        Canvas.Left="{Binding DropIndicator.Left}"
                                        Canvas.Top="{Binding DropIndicator.Top}"
                                        Width="{Binding DropIndicator.Width}"
                                        Height="{Binding DropIndicator.Height}" />
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!--
              right: what the selected cell is made of, then what the last save found. The inspector
              comes first because it is the part that changes what the other one will say — and
              because a property with no editor beside it is a file you have to leave this window to
              edit, which is how the palette came to offer only the two kinds it could name.
            -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="12,0,0,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource Text_Bench_Surface_Properties}"
                               FontWeight="SemiBold"
                               IsVisible="{Binding HasSelection}"
                               Margin="0,0,0,8" />

                    <!--
                      One row per property of the selected kind, generated from the element rather than
                      written out here: the contract already says which properties each kind has, and
                      a second copy of that table in XAML is a second thing to forget. The label is the
                      property's name in the file, so the screen and the JSON agree.
                    -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Fields}"
                                  IsVisible="{Binding HasSelection}"
                                  Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:SurfaceFieldVM}">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.6" />
                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                             IsVisible="{Binding IsText}" />
                                    <ComboBox ItemsSource="{Binding Choices}"
                                              SelectedItem="{Binding Value, Mode=TwoWay}"
                                              IsVisible="{Binding IsChoice}"
                                              HorizontalAlignment="Stretch">
                                        <!--
                                          The type field's items are the schema's own words, because
                                          ChangeType compares the chosen value against them; only the
                                          words on screen are translated.
                                        -->
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SurfaceKindName}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                      Removing is a deliberate act, beside the panel that says what will be removed —
                      and it is only offered while something is selected, so the button cannot be
                      pressed with nothing to delete. The cell's own corner used to carry this, which
                      made a click on the cell's label delete the cell.
                    -->
                    <Button Grid.Row="2"
                            Classes="danger"
                            IsVisible="{Binding HasSelection}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,0,16"
                            ToolTip.Tip="{DynamicResource Text_Bench_Surface_Remove}"
                            Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding Selected}"
                            Content="{DynamicResource Text_Bench_Surface_Remove}" />

                    <TextBlock Grid.Row="3"
                               Text="{DynamicResource Text_Bench_Surface_Check}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <!-- The editor's own refusal: one gesture, one sentence. -->
                            <Border IsVisible="{Binding HasValidationMessage}"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="8">
                                <TextBlock Text="{Binding ValidationMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                            </Border>

                            <!--
                              One row per finding, because a save can find several and they are
                              separate claims. The code under the sentence is the part that survives
                              rewording, and the part a reader quotes when asking somebody else
                              about it — a paragraph of three sentences had neither property.
                            -->
                            <ItemsControl ItemsSource="{Binding Diagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type contract:Diagnostic}">
                                        <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="8"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Converter={StaticResource SurfaceDiagnosticText}}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="10"
                                                           Opacity="0.55"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="5"
                               Text="{Binding StatusLine}"
                               FontSize="12"
                               Opacity="0.75"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
