<Window x:Class="KitX.Dashboard.Views.SurfaceEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:Material.Icons.Avalonia"
        xmlns:contract="using:KitX.ToolKit.Contract"
        xmlns:decl="using:KitX.ToolKit.Contract.Declaration"
        xmlns:viewModels="using:KitX.Dashboard.ViewModels"
        Title="{DynamicResource Text_Bench_Surface_Title}"
        Width="1180"
        Height="900"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!--
          The canvas is a fixed 390 x 845 rectangle, centred, with margin around it. It is not
          stretched to the window and has no zoom control: stretching would make "what you see is
          what you get" a lie (a 1600-wide window would lay out a desktop card), and zooming would
          make the author answer a question this screen cannot — how wide is one cell right now.
        -->
        <Style Selector="Border.canvas">
            <Setter Property="Width" Value="390" />
            <Setter Property="Height" Value="845" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--
          The grip is invisible until the pointer is near it. Always-drawn handles would put eleven
          lines on a card that will be seen with none, and the author would be laying out around the
          editor's furniture. Cursor is set to the resize shape so pointing at the gap says what it
          does without a caption.
        -->
        <!--
          The selected cell, drawn rather than captioned: the frame around it is the only statement on
          this canvas that says what the inspector is describing, and a second one ("editing: ...") in
          the right column would be a sentence doing a border's job.
        -->
        <Style Selector="Border.cell.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Border.grip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.grip:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *" Margin="16">

        <!-- ── toolbar ───────────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                <TextBlock Text="{DynamicResource Text_Bench_Surface_Title}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ToolkitId}"
                           FontSize="12"
                           Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="ContentSave" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Save}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="16" Height="16" Kind="DeleteSweep" />
                        <TextBlock Text="{DynamicResource Text_Bench_Surface_Clear}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── editor body ──────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="220, *, 260">

            <!--
              left: two lists, and the order between them is the point. What is declared comes first,
              so a card is built out of what the ToolKit publishes; the interactive kinds come second,
              under their own heading, because a card with data on it and no way to press anything
              cannot be authored at all — which is what the previous build offered.
            -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0,0,12,0">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource Text_Bench_Surface_Palette}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding UnplacedKeys}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type decl:KeyDeclaration}">
                                <Button Classes="palette"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].DataContext.PlaceCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Vertical" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Text="{DynamicResource Text_Bench_Surface_Actions}"
                               FontWeight="SemiBold"
                               Margin="0,16,0,8" />

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding PaletteKinds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="palette"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].DataContext.AddKindCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- centre: the fixed canvas, scrolled rather than stretched when the window is short -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,0">
                <!-- Named so a test can reach it without depending on when the visual tree is
                     built: an unreached visual cannot be checked for the brushes it resolved. -->
                <Border x:Name="SurfaceCanvas" Classes="canvas" PointerPressed="OnCanvasPressed">
                    <Grid RowDefinitions="Auto,*">
                        <!-- A scale for the rows below, not a grid: since Q101 a row divides itself
                             and its cells have no width in common with the next row's. Four equal
                             ticks would name divisions that nothing on the canvas uses. -->
                        <Border Grid.Row="0" Height="24"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                BorderThickness="0,0,0,1" />

                        <!--
                          Both layers share this cell. A Canvas arranges children at absolute
                          positions but gives them no size of their own, so an ItemsControl placed
                          directly inside one measures to zero and draws nothing — the cells were
                          laid out correctly and never rendered. They live in a Grid instead, and
                          the Grid is what the drag measures its x against.
                        -->
                        <Grid Grid.Row="1" x:Name="SurfaceCanvasLayer">

                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <!--
                                      A ControlTheme's setters are resolved outside this file's XAML
                                      name scope, so a cast such as
                                      ((viewModels:SurfaceElementVM)DataContext) cannot be resolved
                                      there at runtime: the window threw "Unable to resolve type
                                      viewModels:SurfaceElementVM" while measuring and never
                                      appeared. The cast was never needed — the ContentPresenter
                                      this theme targets has the element itself as its DataContext,
                                      so a plain path reaches the same property.
                                    -->
                                    <ControlTheme TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SurfaceElementVM}">
                                        <Border Classes="cell"
                                                Classes.selected="{Binding IsSelected}"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                PointerPressed="OnCellPressed"
                                                ToolTip.Tip="{Binding Description}">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <!--  Trimming, not clipping: at ten equal weights a
                                                      cell is 31px wide and 15px of that is content,
                                                      so "Button" cannot be drawn. Left to clip it
                                                      renders as "But", which reads as a word rather
                                                      than as a cut.  -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Kind}"
                                                           FontSize="10"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!--  One control, at the bottom right: remove. A
                                                      weight is not typed here any more — dragging the
                                                      border beside the cell sets it, so there is
                                                      nothing to confirm and nothing to explain.  -->
                                                <Button Grid.Row="2"
                                                        Classes="flat"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        ToolTip.Tip="{DynamicResource Text_Bench_Surface_Remove}"
                                                        Command="{Binding $parent[Window].DataContext.RemoveCommand}"
                                                        CommandParameter="{Binding}">
                                                    <icon:MaterialIcon Width="14" Height="14" Kind="Close" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                              Borders last, so they draw above the cells and take the press in the
                              gap rather than letting it fall through to a cell's content.
                            -->
                            <ItemsControl ItemsSource="{Binding Boundaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SurfaceBoundaryVM}">
                                        <!--
                                          The grab area is exactly one gap wide, so it never covers
                                          a cell's own content. Pointer capture is taken on press
                                          and released on lift: the drag is the whole interaction,
                                          and there is no state left behind after it.
                                        -->
                                        <Border Classes="grip"
                                                Width="{Binding HitWidth}"
                                                Height="{Binding Height}"
                                                PointerPressed="OnBoundaryPressed"
                                                PointerMoved="OnBoundaryMoved"
                                                PointerReleased="OnBoundaryReleased">
                                            <Border Width="3"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                    Opacity="0.35"
                                                    IsHitTestVisible="False" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!--
              right: what the selected cell is made of, then what the last save found. The inspector
              comes first because it is the part that changes what the other one will say — and
              because a property with no editor beside it is a file you have to leave this window to
              edit, which is how the palette came to offer only the two kinds it could name.
            -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="12,0,0,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource Text_Bench_Surface_Properties}"
                               FontWeight="SemiBold"
                               IsVisible="{Binding HasSelection}"
                               Margin="0,0,0,8" />

                    <!--
                      One row per property of the selected kind, generated from the element rather than
                      written out here: the contract already says which properties each kind has, and
                      a second copy of that table in XAML is a second thing to forget. The label is the
                      property's name in the file, so the screen and the JSON agree.
                    -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Fields}"
                                  IsVisible="{Binding HasSelection}"
                                  Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:SurfaceFieldVM}">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.6" />
                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                             IsVisible="{Binding IsText}" />
                                    <ComboBox ItemsSource="{Binding Choices}"
                                              SelectedItem="{Binding Value, Mode=TwoWay}"
                                              IsVisible="{Binding IsChoice}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="2"
                               Text="{DynamicResource Text_Bench_Surface_Check}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <!-- The editor's own refusal: one gesture, one sentence. -->
                            <Border IsVisible="{Binding HasValidationMessage}"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="8">
                                <TextBlock Text="{Binding ValidationMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                            </Border>

                            <!--
                              One row per finding, because a save can find several and they are
                              separate claims. The code under the sentence is the part that survives
                              rewording, and the part a reader quotes when asking somebody else
                              about it — a paragraph of three sentences had neither property.
                            -->
                            <ItemsControl ItemsSource="{Binding Diagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type contract:Diagnostic}">
                                        <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="8"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Message}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="10"
                                                           Opacity="0.55"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="4"
                               Text="{Binding Status}"
                               FontSize="12"
                               Opacity="0.75"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
