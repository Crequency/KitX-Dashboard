<UserControl x:Class="KitX.Dashboard.Views.Pages.ToolkitPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icon="using:Material.Icons.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pageVMs="using:KitX.Dashboard.ViewModels.Pages"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">
    <DockPanel>
        <!-- Top toolbar -->
        <Grid Height="80" DockPanel.Dock="Top">
            <StackPanel Margin="25,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{DynamicResource Text_ToolKit_Title}"/>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Bottom"
                           FontSize="13"
                           Opacity="0.6"
                           Text="{DynamicResource Text_ToolKit_Subtitle}"/>
            </StackPanel>

            <StackPanel Margin="0,0,20,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                <Button Command="{Binding CreateToolkitCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:MaterialIcon Width="18" Height="18" Kind="Plus"/>
                        <TextBlock Text="{DynamicResource Text_ToolKit_Create}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    IsVisible="{Binding IsEmpty}">
            <icon:MaterialIcon Width="56" Height="56" HorizontalAlignment="Center" Kind="Toolbox"/>
            <TextBlock HorizontalAlignment="Center" FontSize="16" Text="{DynamicResource Text_ToolKit_EmptyTitle}"/>
            <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Text="{DynamicResource Text_ToolKit_EmptyHint}"/>
            <Button HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding CreateToolkitCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icon:MaterialIcon Width="18" Height="18" Kind="Plus"/>
                    <TextBlock Text="{DynamicResource Text_ToolKit_Create}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Card grid -->
        <ScrollViewer IsVisible="{Binding HasCards}">
            <ItemsControl ItemsSource="{Binding Cards}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pageVMs:ToolkitCardVM}">
                        <Border Width="320"
                                Margin="10"
                                Padding="16"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource KitXRadiusCard}"
                                BorderBrush="{DynamicResource ThemeControlBorderBrushDefault}">
                            <StackPanel Spacing="8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"/>
                                    <TextBlock Margin="10,0,0,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Opacity="0.6"
                                               Text="{Binding Version}"/>
                                </DockPanel>
                                <TextBlock FontSize="12"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding Description}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"/>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="16">
                                    <TextBlock FontSize="12" Text="{Binding WorkflowCount, StringFormat='{}{0} 工作流'}"/>
                                    <TextBlock FontSize="12" Text="{Binding TriggerCount, StringFormat='{}{0} 触发'}"/>
                                    <TextBlock FontSize="12" Text="{Binding PluginCount, StringFormat='{}{0} 插件'}"/>
                                </StackPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <ToggleSwitch DockPanel.Dock="Left"
                                                  IsChecked="{Binding IsMounted}"
                                                  Command="{Binding ToggleMountCommand}"
                                                  VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding OpenBenchCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icon:MaterialIcon Width="16" Height="16" Kind="Toolbox"/>
                                                <TextBlock Text="{DynamicResource Text_ToolKit_OpenBench}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding $parent[UserControl].DataContext.DeleteToolkitCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icon:MaterialIcon Width="16" Height="16" Kind="Delete"/>
                                                <TextBlock Text="{DynamicResource Text_ToolKit_Delete}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
