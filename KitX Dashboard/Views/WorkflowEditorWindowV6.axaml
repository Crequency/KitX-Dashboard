<Window x:Class="KitX.Dashboard.Views.WorkflowEditorWindowV6"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="using:AvaloniaEdit"
        xmlns:icon="using:Material.Icons.Avalonia"
        xmlns:controls="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
        xmlns:converters="using:KitX.Dashboard.Converters"
        xmlns:viewModels="using:KitX.Dashboard.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="700"
        d:DesignWidth="1200"
        Title="KitX Workflow Editor (v6)"
        Width="1200"
        Height="800">

    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

        <!-- V6 Input connector template -->
        <DataTemplate x:Key="V6InputConnectorTemplate" DataType="{x:Type viewModels:BlueprintConnectorVMV6}">
            <controls:NodeInput IsConnected="{Binding IsConnected}"
                                Anchor="{Binding Anchor, Mode=OneWayToSource}">
                <ToolTip.Tip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="Title" />
                        <Binding Path="PinTypeText" />
                    </MultiBinding>
                </ToolTip.Tip>
                <controls:NodeInput.BorderBrush>
                    <Binding Path="PinTypeColorHex" Converter="{StaticResource HexToBrushConverter}" />
                </controls:NodeInput.BorderBrush>
                <controls:NodeInput.Header>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="11" />
                </controls:NodeInput.Header>
            </controls:NodeInput>
        </DataTemplate>

        <!-- V6 Output connector template -->
        <DataTemplate x:Key="V6OutputConnectorTemplate" DataType="{x:Type viewModels:BlueprintConnectorVMV6}">
            <controls:NodeOutput IsConnected="{Binding IsConnected}"
                                 Anchor="{Binding Anchor, Mode=OneWayToSource}">
                <ToolTip.Tip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="Title" />
                        <Binding Path="PinTypeText" />
                    </MultiBinding>
                </ToolTip.Tip>
                <controls:NodeOutput.BorderBrush>
                    <Binding Path="PinTypeColorHex" Converter="{StaticResource HexToBrushConverter}" />
                </controls:NodeOutput.BorderBrush>
                <controls:NodeOutput.Header>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="11" />
                </controls:NodeOutput.Header>
            </controls:NodeOutput>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Unified Toolbar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <DockPanel>
                <!-- Left: Back to Dashboard -->
                <Button DockPanel.Dock="Left"
                        Command="{Binding ShowDashboardCommand}"
                        ToolTip.Tip="Back to Dashboard"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <icon:MaterialIcon Width="18" Height="18" Kind="ArrowLeft" />
                        <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Right: Run/Stop/Debug -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Name="RunButton"
                            ToolTip.Tip="Run"
                            Command="{Binding RunCommand}"
                            IsEnabled="{Binding !IsExecuting}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <icon:MaterialIcon Width="18" Height="18" Kind="Play" />
                            <TextBlock Text="Run" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Name="DebugButton"
                            ToolTip.Tip="Debug Mode"
                            Command="{Binding DebugRunCommand}"
                            IsEnabled="{Binding !IsExecuting}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <icon:MaterialIcon Width="18" Height="18" Kind="BugOutline" />
                            <TextBlock Text="Debug" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Name="StopButton"
                            ToolTip.Tip="Stop"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding IsExecuting}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <icon:MaterialIcon Width="18" Height="18" Kind="Stop" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: Mode toggle + metadata -->
                <StackPanel HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBox Text="{Binding WorkflowName, Mode=TwoWay}"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Background="Transparent"
                             BorderThickness="0"
                             MinWidth="150"
                             MaxWidth="300"
                             VerticalAlignment="Center" />

                    <!-- Metadata toggle -->
                    <ToggleButton Name="MetadataToggleButton"
                                  VerticalAlignment="Center"
                                  Padding="4"
                                  ToolTip.Tip="Show metadata">
                        <icon:MaterialIcon Width="16" Height="16" Kind="InformationOutline" />
                    </ToggleButton>

                    <Border Width="1" Height="24" Background="{DynamicResource ControlStrokeColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button Padding="12,6"
                                CornerRadius="4,0,0,4"
                                Command="{Binding SwitchToBlockScriptCommand}"
                                IsEnabled="{Binding !IsBlockScriptMode}">
                            <TextBlock Text="KScript" />
                        </Button>
                        <Button Padding="12,6"
                                CornerRadius="0,4,4,0"
                                Command="{Binding SwitchToBlueprintCommand}"
                                IsEnabled="{Binding !IsBlueprintMode}">
                            <TextBlock Text="Blueprint" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Collapsible metadata panel (Description + Author) -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="0,0,0,1"
                Padding="15,6"
                IsVisible="{Binding #MetadataToggleButton.IsChecked, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="10,0,10,0">
                <TextBlock Text="Description: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding WorkflowDescription, Mode=TwoWay}"
                         Watermark="Workflow description..."
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         Margin="0,0,20,0" />
                <TextBlock Grid.Column="2" Text="Author: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBox Grid.Column="3"
                         Text="{Binding WorkflowAuthor, Mode=TwoWay}"
                         Watermark="Author name..."
                         Background="Transparent"
                         BorderThickness="0,0,0,1" />
            </Grid>
        </Border>

        <!-- Conversion error bar -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding ConversionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Padding="10,4">
            <TextBlock Text="{Binding ConversionError}"
                       FontSize="11"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Bottom status bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Mode, StringFormat='Mode: {0}'}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- Main Content Area: Three columns -->
        <Grid ColumnDefinitions="200,5,*,5,250">

            <!-- ==================== Left Panel ==================== -->
            <!-- BS Mode: Trigger + Helper Functions -->
            <DockPanel Grid.Column="0"
                       IsVisible="{Binding IsBlockScriptMode}"
                       Margin="5">

                <!-- Trigger Settings -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1"
                        Padding="5,8" Margin="0,0,0,5">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Trigger" FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ComboBox ItemsSource="{Binding TriggerTypeOptions}"
                                  SelectedItem="{Binding TriggerType, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <StackPanel IsVisible="{Binding IsPluginEventTrigger}" Spacing="4">
                            <TextBlock Text="Plugin" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ComboBox ItemsSource="{Binding AvailablePlugins}"
                                      SelectedItem="{Binding TriggerPluginName, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11" />
                            <TextBlock Text="Trigger" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableTriggers}"
                                      SelectedItem="{Binding TriggerName, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Code Sections -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Code Sections"
                           FontWeight="Bold"
                           Margin="5,5,5,10" />
                <Button DockPanel.Dock="Top"
                        Name="AddHelperFunctionListButton"
                        Content="Add Helper Function"
                        HorizontalAlignment="Stretch"
                        Margin="5" Padding="5,2" />
                <Button DockPanel.Dock="Top"
                        Name="BackToMainProgramButton"
                        Content="Main Program"
                        HorizontalAlignment="Stretch"
                        Margin="5" Padding="5,2" />
                <ListBox Name="HelperFunctionsListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, Mode=TwoWay}"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MinWidth="80" />
                                <Button Grid.Column="1"
                                        Content="X"
                                        Tag="{Binding}"
                                        Padding="5,2"
                                        Margin="5,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- BP Mode: Node Palette (placeholder for P3) -->
            <Border Grid.Column="0"
                    IsVisible="{Binding IsBlueprintMode}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Margin="5" CornerRadius="5">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Node Palette"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="BP editing arrives in P3.&#x0a;&#x0a;Switch to KScript mode to edit the workflow source, then switch to Blueprint to view the rendered graph."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource ControlStrokeColorSecondaryBrush}"
                          Width="5" />

            <!-- ==================== Column 2: Main Editor Area ==================== -->
            <Grid Grid.Column="2">

                <!-- BS Mode: Code Editor + Constants Panel -->
                <Grid IsVisible="{Binding IsBlockScriptMode}"
                      RowDefinitions="*,5,200">

                    <!-- Code Editor -->
                    <DockPanel Grid.Row="0" Margin="5">
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="5">
                            <TextBlock Name="CodeEditorTitle"
                                       Text="Main Program"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <avalonedit:TextEditor Name="CodeEditor"
                                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                               FontSize="12"
                                               ShowLineNumbers="True"
                                               IsReadOnly="False"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto" />
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />

                    <!-- Variable Constants / Helper Function Settings Panel -->
                    <DockPanel Grid.Row="2" Margin="5">
                        <!-- Header: Variable Constants -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="5"
                                    IsVisible="{Binding !IsEditingHelperFunction}">
                            <TextBlock Text="Variable Constants"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Button Name="ResetAllConstantsButton"
                                    Content="Reset All"
                                    Margin="10,0,0,0" Padding="5,2" />
                        </StackPanel>

                        <!-- Header: Helper Function Settings -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="5"
                                    IsVisible="{Binding IsEditingHelperFunction}">
                            <TextBlock Text="Helper Function Settings"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Content: Variable Constants -->
                        <ScrollViewer IsVisible="{Binding !IsEditingHelperFunction}">
                            <ItemsControl Name="ConstantsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding UserValue, Mode=TwoWay}"
                                                     Margin="5,0" />
                                            <Button Grid.Column="2"
                                                    Content="R"
                                                    Tag="{Binding}"
                                                    ToolTip.Tip="Reset to default"
                                                    Padding="5,2" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Content: Helper Function Settings -->
                        <ScrollViewer IsVisible="{Binding IsEditingHelperFunction}">
                            <StackPanel Spacing="5" Margin="5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Return" VerticalAlignment="Center" Width="60" />
                                    <TextBox Text="{Binding SelectedHelperFunction.ReturnType, Mode=TwoWay}"
                                             Width="120" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                                    <TextBlock Text="Params:" VerticalAlignment="Center" Width="60" />
                                    <Button Name="AddParameterButton"
                                            Content="Add Parameter" Padding="5,2"
                                            ToolTip.Tip="Add a new parameter" />
                                </StackPanel>
                                <ItemsControl Name="ParametersItemsControl" Margin="0,5,0,0"
                                              ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2">
                                                <TextBox Text="{Binding Type, Mode=TwoWay}"
                                                         Width="50" ToolTip.Tip="Parameter type" />
                                                <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                         Width="70" ToolTip.Tip="Parameter name" />
                                                <Button Content="X" Padding="5,2"
                                                        Tag="{Binding}" ToolTip.Tip="Remove parameter" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- BP Mode: NodifyM Blueprint Canvas -->
                <Border IsVisible="{Binding IsBlueprintMode}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        Margin="5" CornerRadius="5">

                    <Grid>
                        <!-- Empty-state banner -->
                        <StackPanel IsVisible="{Binding !BlueprintVM.HasContent}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Margin="40">
                            <icon:MaterialIcon Width="48" Height="48" Kind="Sitemap"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding BlueprintVM.EmptyBanner}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <!-- NodifyEditor canvas -->
                        <controls:NodifyEditor x:Name="EditorControl"
                                               IsVisible="{Binding BlueprintVM.HasContent}"
                                               DataContext="{Binding BlueprintVM}"
                                               ItemsSource="{Binding Nodes}"
                                               Connections="{Binding Connections}"
                                               PendingConnection="{Binding PendingConnection}"
                                               Background="Transparent">

                            <controls:NodifyEditor.GridLineTemplate>
                                <DataTemplate>
                                    <controls:LargeGridLine Width="{Binding $parent[controls:NodifyEditor].Bounds.Width}"
                                                            Height="{Binding $parent[controls:NodifyEditor].Bounds.Height}"
                                                            OffsetX="{Binding $parent[controls:NodifyEditor].OffsetX}"
                                                            OffsetY="{Binding $parent[controls:NodifyEditor].OffsetY}"
                                                            Zoom="{Binding $parent[controls:NodifyEditor].Zoom}"
                                                            Spacing="15"
                                                            Thickness="0.5"
                                                            Brush="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </DataTemplate>
                            </controls:NodifyEditor.GridLineTemplate>

                            <controls:NodifyEditor.ConnectionTemplate>
                                <DataTemplate>
                                    <controls:Connection Source="{Binding Source.Anchor}"
                                                         Target="{Binding Target.Anchor}"
                                                         StrokeThickness="2.5"
                                                         Spacing="20"
                                                         Direction="Forward">
                                        <controls:Connection.Stroke>
                                            <Binding Path="StrokeColorHex"
                                                     Converter="{StaticResource HexToBrushConverter}" />
                                        </controls:Connection.Stroke>
                                    </controls:Connection>
                                </DataTemplate>
                            </controls:NodifyEditor.ConnectionTemplate>

                            <controls:NodifyEditor.PendingConnectionTemplate>
                                <DataTemplate>
                                    <controls:PendingConnection StartedCommand="{Binding StartCommand}"
                                                                CompletedCommand="{Binding FinishCommand}"
                                                                Direction="Forward">
                                        <controls:PendingConnection.Stroke>
                                            <SolidColorBrush Color="White" Opacity="0.5" />
                                        </controls:PendingConnection.Stroke>
                                    </controls:PendingConnection>
                                </DataTemplate>
                            </controls:NodifyEditor.PendingConnectionTemplate>

                            <controls:NodifyEditor.ItemTemplate>
                                <controls:NodeTemplateSelector>
                                    <!-- Scope frame: decorative background -->
                                    <DataTemplate DataType="{x:Type viewModels:ScopeFrameVM}">
                                        <Border Width="{Binding FrameWidth}"
                                                Height="{Binding FrameHeight}"
                                                CornerRadius="8"
                                                BorderThickness="2"
                                                IsHitTestVisible="False">
                                            <Border.Background>
                                                <Binding Path="BackgroundColorHex"
                                                         Converter="{StaticResource HexToBrushConverter}" />
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <Binding Path="BorderColorHex"
                                                         Converter="{StaticResource HexToBrushConverter}" />
                                            </Border.BorderBrush>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.7"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Margin="8,4" />
                                        </Border>
                                    </DataTemplate>

                                    <!-- Blueprint node -->
                                    <DataTemplate DataType="{x:Type viewModels:BlueprintNodeVMV6}">
                                        <controls:Node Location="{Binding Location, Mode=TwoWay}"
                                                       Input="{Binding Input}"
                                                       Output="{Binding Output}"
                                                       InputConnectorTemplate="{StaticResource V6InputConnectorTemplate}"
                                                       OutputConnectorTemplate="{StaticResource V6OutputConnectorTemplate}"
                                                       IsResize="False">
                                            <controls:Node.Header>
                                                <Border CornerRadius="4,4,0,0"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Stretch">
                                                    <Border.Background>
                                                        <Binding Path="HeaderColorHex"
                                                                 Converter="{StaticResource HexToBrushConverter}" />
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               FontSize="12" />
                                                </Border>
                                            </controls:Node.Header>
                                        </controls:Node>
                                    </DataTemplate>
                                </controls:NodeTemplateSelector>
                            </controls:NodifyEditor.ItemTemplate>
                        </controls:NodifyEditor>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource ControlStrokeColorSecondaryBrush}"
                          Width="5" />

            <!-- ==================== Column 4: Output Panel ==================== -->
            <Border Grid.Column="4" Background="{DynamicResource LayerFillColorDefaultBrush}" Margin="5" CornerRadius="5">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Output"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Name="ClearOutputButton"
                                DockPanel.Dock="Right"
                                Command="{Binding ClearOutputCommand}"
                                ToolTip.Tip="Clear output"
                                Padding="8,2"
                                HorizontalAlignment="Right">
                            <icon:MaterialIcon Width="14" Height="14" Kind="Close" />
                        </Button>
                    </DockPanel>
                    <ScrollViewer Name="OutputScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Name="OutputTextBox"
                                 Text="{Binding ExecutionOutput}"
                                 IsReadOnly="True"
                                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                 FontSize="11"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>