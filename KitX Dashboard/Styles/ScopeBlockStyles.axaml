<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KitX.Dashboard.Controls">

    <!-- Scope Block visual template: large bordered container behind nodes -->
    <Style Selector="controls|ScopeBlockControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MinHeight" Value="150"/>
        <!-- Override NodeGroup's default center alignment -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ScopeBlockControl}">
                    <Border BorderBrush="{TemplateBinding HeaderBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            Width="{Binding Size.Width, RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{Binding Size.Height, RelativeSource={RelativeSource TemplatedParent}}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: colored bar with scope name -->
                            <Border x:Name="PART_Header"
                                    Background="{TemplateBinding HeaderBrush}"
                                    CornerRadius="4,4,0,0"
                                    Cursor="SizeAll"
                                    Padding="10,6">
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </Border>

                            <!-- Body: semi-transparent area -->
                            <Grid Grid.Row="1">
                                <Border Background="{TemplateBinding HeaderBrush}"
                                        Opacity="0.08"/>

                                <!-- Resize thumb -->
                                <Thumb x:Name="PART_ResizeThumb"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,4,4"
                                       Width="16" Height="16"
                                       Cursor="BottomRightCorner"
                                       IsVisible="{TemplateBinding CanResize}">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent"
                                                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                    BorderThickness="0,1,1,0"
                                                    CornerRadius="0,0,4,0"
                                                    Opacity="0.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Override Node's hover/selected styles for scope blocks -->
    <Style Selector="controls|ScopeBlockControl:pointerover">
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="controls|ScopeBlockControl[IsSelected=True]">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</Styles>
